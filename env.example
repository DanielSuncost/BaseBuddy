# BaseBuddy Configuration
# Copy this file to .env and configure your settings

# ============================================================================
# CAMERA CONFIGURATION
# ============================================================================
CAM1=rtsp://username:password@192.168.1.10:554/stream1
CAM2=rtsp://username:password@192.168.1.11:554/stream1
CAM3=
CAM4=

# ============================================================================
# SERVER SETTINGS
# ============================================================================
HOST=0.0.0.0
PORT=5000
FLASK_ENV=production

# ============================================================================
# AI DETECTION SETTINGS
# ============================================================================
DETECTION_ENABLED=true
AI_MODEL=yolov8n.pt
AI_CONF=0.35

# False-positive zones: marking a detection in the gallery saves camera+class+bbox; future
# overlapping detections are not written to the DB (no gallery spam). Tune overlap sensitivity:
# FALSE_POSITIVE_ZONES_ENABLE=true
# FALSE_POSITIVE_ZONE_IOU=0.35

# ============================================================================
# INFERENCE BACKEND (local GPU, cloud, or hybrid)
# ============================================================================
INFERENCE_MODE=local
# INFERENCE_CLOUD_ENDPOINT=https://api.basebuddy.io/v1
# INFERENCE_CLOUD_API_KEY=
# INFERENCE_HYBRID_FALLBACK=true
# INFERENCE_CLOUD_TIMEOUT_S=5

# ============================================================================
# HOME SCENES (pantry / fridge monitoring)
# ============================================================================
HOME_SCENES_ENABLE=true

# ============================================================================
# SECURITY (recommended for production when HOST is not localhost)
# ============================================================================
# AUTH_ENABLE=true
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# SECRET_KEY=generate-a-long-random-string
# Production: restrict cross-origin (default is same-origin only when FLASK_ENV=production)
# CORS_ORIGINS=http://192.168.1.50:5000
#
# Restrict secrets on disk after editing:
#   chmod 600 .env config.txt

# ============================================================================
# RECORDING SETTINGS
# ============================================================================
SEG_MINUTES=15
RETENTION_DAYS=7
RECORD_ROOT=./recordings
JPEG_QUALITY=85

# ============================================================================
# BACKUP SETTINGS
# ============================================================================
BACKUP_ENABLED=false
BACKUP_DRIVE_PATH=/media/backup
BACKUP_FOLDER=backup_surveillance_recordings
BACKUP_INTERVAL_HOURS=24
BACKUP_MAX_AGE_HOURS=168

# ============================================================================
# STORAGE & RETENTION
# ============================================================================
# Per-service retention JSON (see /storage UI). Legacy RETENTION_DAYS syncs recordings.local_days.
RETENTION_DAYS=7
RETENTION_SCAN_HOURS=1
# RETENTION_POLICY={"recordings":{"local_days":7,"remote_days":30},"detections":{"local_days":14,"remote_days":90}}

# BYO S3-compatible remote storage (AWS S3, Cloudflare R2, Backblaze B2)
REMOTE_STORAGE_ENABLED=false
REMOTE_STORAGE_PROVIDER=r2
REMOTE_BUCKET=
REMOTE_REGION=auto
REMOTE_ENDPOINT=
REMOTE_PREFIX=basebuddy
REMOTE_ACCESS_KEY=
REMOTE_SECRET_KEY=

# Optional: path to a local DUSt3R clone (see modules/multiview/dust3r_wrapper.py)
# DUST3R_PATH=/path/to/dust3r

# 3D reconstruction engines (see docs/OPTIONAL_DEPS.md)
# VGGT checkpoint; use facebook/VGGT-1B-Commercial for commercial deployments
# VGGT_MODEL=facebook/VGGT-1B
# Path to a local Pi3 clone (weights are non-commercial)
# PI3_PATH=/path/to/Pi3

# BaseBuddy Cloud (requires private basebuddy_premium package)
# BASEBUDDY_MANAGED_CLOUD_ENABLED=true
# BASEBUDDY_CLOUD_API_URL=https://your-cloud-api.example.com
# BASEBUDDY_CLOUD_API_KEY=

# ============================================================================
# INTEGRATIONS (MQTT, alerts, recording modes, performance)
# ============================================================================
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=basebuddy
MQTT_CLIENT_ID=basebuddy
# MQTT_USERNAME=
# MQTT_PASSWORD=

NOTIFY_ENABLED=true
NOTIFY_FALLBACK_GLOBAL=true
NOTIFY_INCLUDE_CLIP_DEFAULT=true
# NOTIFY_PUBLIC_BASE_URL=https://your-server.example.com:5001
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/basebuddy

# Telegram — sends detection image via file upload (works on local server)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Email (SMTP) — attaches detection JPEG
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_TO=you@example.com
# SMTP_USE_TLS=true

# Pushover — mobile push with link
# PUSHOVER_USER_KEY=
# PUSHOVER_API_TOKEN=

# SMS (Twilio) — text with link to snapshot/clip
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# TWILIO_TO_NUMBER=

# ONBOARDING_COMPLETE=true  # set by Config → Getting Started when finished

# Alert rules are configured in /integrations UI (per camera, per class).

# continuous | motion | detection | off
RECORDING_MODE=continuous
EVENT_CLIP_PRE_S=5
EVENT_CLIP_POST_S=5

# vaapi | cuda | qsv (empty = software decode)
# FFMPEG_HWACCEL=

# pt | tensorrt | openvino (requires exported .engine or OpenVINO model dir)
INFERENCE_BACKEND=pt
# MULTIPROC_DETECTION=true

# LPR_ENABLED=false
# LPR_CLASSES=car,truck,bus

# Plant monitoring — vision API (configure in /plants UI or here)
# PLANT_VISION_API_URL=https://api.openai.com/v1/chat/completions
# PLANT_VISION_API_KEY=
# PLANT_VISION_MODEL=gpt-4o-mini

# Traffic analysis (see /traffic page)
# TRAFFIC_CAM_ID=0
# PX_PER_M=50

# Plugins enabled by default: traffic_analytics, training
# PLUGINS_ENABLED=traffic_analytics,training,plant_tracking

# Training datasets upload to REMOTE_* bucket under training-datasets/<id>/
# Local copies: ./training_datasets/  ·  Job outputs: ./training_runs/

STILLS_ROOT=./stills
TIMELAPSE_OUTPUT=./timelapse_output

# ============================================================================
# DATABASE SETTINGS
# ============================================================================
DATABASE_PATH=./analytics.db


